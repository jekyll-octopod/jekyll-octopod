#!/usr/bin/env ruby
# require "byebug"
PWD = Dir.pwd

GEM_SPEC = Gem::Specification.find_by_name("jekyll-octopod")
GEM_DIR = GEM_SPEC.gem_dir
# HAS20170501 disgusting hack for development
# GEM_DIR = "/home/user/jekyll/jekyll-octopod/"


require 'rubygems'
require 'optparse'
require 'yaml'
require 'fileutils'


octopod_help = <<HELP
Octopod - podcast publishing for geeks

Basic Command Line Usage:
  Standard Jekyll commands:
    octopod b[uild]                                                # . -> ./_site
    octopod build <path to write generated site>                   # . -> <path>
    octopod build <path to source> <path to write generated site>  # <path> -> <path>
    octopod import <importer name> <options>                       # imports posts using named import script
    octopod setup                                                  # Setup blog to become podcast-aware, copy assets and default config
    octopod s[erver]                                               # Starts the server

  Additional Octopod commands:
    octopod episode                                           # adds a template for a new episode
    octopod deploy                                            # deploys your site
    octopod update                                            # updates template files from an existing setup to
                                                                # the currently installed jekyll-octopod version,
                                                                # without touching posts, imprint.md or index.md,
                                                                # and rewrites the old '{% podigee_player %}' tag
                                                                # to '{% podlove_player %}' wherever it's still used

  See 'octopod <command> --help' for more information on a specific command.

Configuration is read from '<source>/_config.yml' but can be overridden
using the following options:

HELP

episode_help = <<EPISODE_HELP
octopod episode - generates a template to post your next episode

octopod episode [options] [audio file[, audio file]]

Configuration is read from '<source>/_config.yml' but can be overridden
using the following options:

EPISODE_HELP

deploy_help = <<DEPLOY_HELP
octopod deploy - deploys website via rsync

octopod deploy [path to write generated site] [options]

Configuration is read from '<source>/_config.yml' but can be overridden
using the following options:

DEPLOY_HELP

DEFAULT_EXT = '.md'

class OptionParser
  alias_method :_octopod_banner=, :banner=
  def banner=(_)
    return ''
  end
end

def ok_failed(condition)
  if (condition)
    puts "OK"
  else
    puts "FAILED"
  end
end

def write_file?(filename)
  if File.exist?(filename)
    unless ["Y","N"].include?(@answer)
      puts ""
      @answer = ask("File '#{filename}' already exists. Overwrite? Capitalized answer for ALL files.", ['y', 'Y', 'n', 'N'])
    end
    ["Y", "y"].include?(@answer)
  else
    true
  end
end

def copy_file_or_create_dir(file)
  filename = file.split(GEM_DIR + "/assets")[1]
  if File.directory?(file)
    FileUtils.mkdir(PWD + filename, verbose: true) unless File.exist?(PWD + filename)
  else
    if write_file?(PWD + filename)
      FileUtils.cp(file, PWD + filename, verbose: true)
    end
  end
end

# Removes a leftover site-local copy of something that's now served by the jekyll-octopod-bulma
# theme gem instead (see 'now_theme_served' in the 'update' command). '.md' files are always kept,
# no matter where they're found, since they're real content rather than theme boilerplate.
def remove_theme_served_path(path)
  return unless File.exist?(path)

  if File.directory?(path)
    Dir.glob(File.join(path, '**', '*'), File::FNM_DOTMATCH).sort.reverse_each do |entry|
      next if File.basename(entry) == '.' || File.basename(entry) == '..'
      if File.directory?(entry)
        FileUtils.rmdir(entry, verbose: true) if Dir.empty?(entry)
      elsif !entry.end_with?('.md')
        FileUtils.rm(entry, verbose: true)
      end
    end
    FileUtils.rmdir(path, verbose: true) if Dir.exist?(path) && Dir.empty?(path)
  elsif !path.end_with?('.md')
    FileUtils.rm(path, verbose: true)
    # Clean up now-empty parent directories this file leaves behind (e.g. img/logo/ once every
    # generic favicon file under it is gone), but never touch PWD itself and never remove a
    # directory that still holds real, unrelated content (a site's own photos alongside the
    # generic ones, say) - Dir.empty? guards that.
    parent = File.dirname(path)
    while parent != PWD && Dir.exist?(parent) && Dir.empty?(parent)
      FileUtils.rmdir(parent, verbose: true)
      parent = File.dirname(parent)
    end
  end
end

# 'now_theme_served' used to list '_layouts' and 'img' wholesale, on the assumption that a legacy
# site's copies of those directories were 100% gem output. That's wrong whenever a site added its
# own files alongside them - a custom '_layouts/presentation.html' with no gem equivalent, or real
# content photos dropped into 'img/' - since a whole-directory delete has no way to tell those apart
# from the generic files it's supposed to clean up. This instead lists the theme gem's *actual*
# shipped filenames in those two directories, read from the installed jekyll-octopod-bulma gem
# itself (same reasoning as the version-constraint lookup in update_gemfile_and_theme_config: read
# from the gem so this can't drift out of sync as its shipped file list changes) - so 'update' only
# ever removes a file that's actually theme content, and leaves anything else in place.
def theme_shipped_generic_files
  theme_gem_dir = begin
    Gem::Specification.find_by_name('jekyll-octopod-bulma').gem_dir
  rescue Gem::MissingSpecError
    nil
  end
  return [] unless theme_gem_dir

  layouts = Dir.glob(File.join(theme_gem_dir, '_layouts', '*')).map { |f| "_layouts/#{File.basename(f)}" }
  img = Dir.glob(File.join(theme_gem_dir, 'assets', 'img', '**', '*'), File::FNM_DOTMATCH)
            .reject { |f| File.directory?(f) }
            .map { |f| f.sub("#{theme_gem_dir}/assets/", '') }
  layouts + img
end

# Points a site's Gemfile and _config.yml at jekyll-octopod-bulma instead of the old direct
# jekyll-bulma dependency/theme setting. Mirrors the version constraint this gem itself declares on
# jekyll-octopod-bulma (see jekyll-octopod.gemspec) rather than hardcoding one here, so it can't
# drift out of sync as that constraint changes across releases.
def update_gemfile_and_theme_config
  bulma_constraint = GEM_SPEC.dependencies.find { |d| d.name == 'jekyll-octopod-bulma' }&.requirement&.to_s
  new_gem_line = "gem 'jekyll-octopod-bulma'#{bulma_constraint ? ", '#{bulma_constraint}'" : ''}"

  gemfile_path = PWD + '/Gemfile'
  if File.exist?(gemfile_path)
    gemfile = File.read(gemfile_path)
    jekyll_bulma_line = /^(\s*)gem\s+(['"])jekyll-bulma\2.*$/

    if gemfile.match?(jekyll_bulma_line)
      gemfile = gemfile.sub(jekyll_bulma_line) { "#{$1}#{new_gem_line}" }
      File.write(gemfile_path, gemfile)
      puts "Replaced the 'jekyll-bulma' line in Gemfile with: #{new_gem_line}"
    elsif !gemfile.match?(/gem\s+(['"])jekyll-octopod-bulma\1/)
      jekyll_octopod_line = /^(\s*)gem\s+(['"])jekyll-octopod\2.*$/
      if gemfile.match?(jekyll_octopod_line)
        gemfile = gemfile.sub(jekyll_octopod_line) { |line| "#{line}\n#{$1}#{new_gem_line}" }
        File.write(gemfile_path, gemfile)
        puts "Added to Gemfile, next to 'jekyll-octopod': #{new_gem_line}"
      else
        puts "Couldn't find a 'jekyll-octopod' line in Gemfile to add 'jekyll-octopod-bulma' next"
        puts "to - add it yourself: #{new_gem_line}"
      end
    else
      puts "Gemfile already references 'jekyll-octopod-bulma'."
    end
  else
    puts "No Gemfile found - skipping."
  end

  config_path = PWD + '/_config.yml'
  if File.exist?(config_path)
    config = File.read(config_path)
    theme_line = /^theme:\s*jekyll-bulma\s*$/
    if config.match?(theme_line)
      File.write(config_path, config.sub(theme_line, 'theme: jekyll-octopod-bulma'))
      puts "Updated 'theme: jekyll-bulma' to 'theme: jekyll-octopod-bulma' in _config.yml."
    end
  end
end

def ask(message, valid_options = nil)
  if valid_options
    answer = get_stdin("#{message} #{valid_options.to_s.gsub(/"/, '').gsub(/, /,'/')} ") while !valid_options.include?(answer)
  else
    answer = get_stdin(message)
  end
  answer
end

def get_stdin(message)
  print message
  STDIN.gets.chomp
end

if ARGV.size > 0 && (ARGV[0] == 'episode' || ARGV[0] == 'deploy' || ARGV[0] == 'setup' || ARGV[0] == 'update')
  options = YAML.load_file(File.join(PWD, '_config.yml'))
  options['posts_dir'] = File.join(PWD, '_posts')

  case ARGV[0]

  when 'episode'
    post_header = {
      'title'         => 'A Title',
      'subtitle'      => "A Subtle Subtitle",
      'datum'         => 'May 22nd, 2016',
      'layout'        => 'post',
      'author'        => options['author'],
      'explicit'      => options['explicit'] || 'no',
      'duration'      => "0:01:00",
      'audio'         => {
        'm4a'  => 'name.m4a',
        'mp3'  => 'name.mp3',
        'ogg'  => 'name.ogg'},
      'filesize'         => {
        'm4a'  => 1234567,
        'mp3'  => 2345678,
        'ogg'  => 3456789}, 
      'chapters'      => [
        '00:00:00.000 Intro.',
        '00:00:30.000 Outro.'
      ]
    }

    opts = OptionParser.new do |opts|
      opts._octopod_banner = episode_help

      opts.on("-a", "--author [AUTHOR]", "Name of post author") do |episode_author|
        post_header['author'] = options['author'] = episode_author
      end

      opts.on("-c", "--chapters [chapter1,chapter2,...]", Array, "The episodes chapters.") do |episode_chapters|
        warn episode_chapters.inspect
        post_header['chapters'] = options['chapters'] = episode_chapters
      end

      opts.on("-d", "--duration [DURATION]", "Duration of the episode") do |episode_duration|
        post_header['duration'] = options['duration'] = episode_duration.to_i
      end

      opts.on("-e", "--explicit [yes/no]", "Explicit rating for this episode (default: 'no')") do |episode_explicit|
        post_header['explicit'] = options['explicit'] = episode_explicit
      end

      opts.on("-l", "--layout [LAYOUT]", "Layout to use (default: 'post')") do |episode_layout|
        post_header['layout'] = options['layout'] = episode_layout
      end

      opts.on("-p", "--posts-dir [PATH]", "Path to the post directory (default: '_posts')") do |episode_posts_dir|
        options['posts_dir'] = episode_posts_dir
      end

      opts.on("-s", "--subtitle [TEXT]", "Subtitle of the episode") do |episode_subtitle|
        post_header['subtitle'] = options['subtitle'] = episode_subtitle
      end

      opts.on("--summary [TEXT]", "Summary of the episode") do |episode_summary|
        post_header['summary'] = options['summary'] = episode_summary
      end

      opts.on("--tags [tag1,tag2,...]", Array, "Tags for the episode") do |episode_tags|
        post_header['tags'] = options['tags'] = episode_tags
      end

      opts.on("-t", "--title [TEXT]", "Title of the episode") do |episode_title|
        post_header['title'] = options['title'] = episode_title
      end
    end
    opts.parse!

    unless FileTest.directory?(options['posts_dir'])
      abort("rake aborted: '#{options['posts_dir']}' directory not found.")
    end

    post_header['title'] = post_header['title'] || 'untitled'
    slug = post_header['title'].downcase.strip.gsub(' ', '-').gsub(/[^\w-]/, '_')
    date = Time.now.strftime('%Y-%m-%d')

    filename = File.join(options['posts_dir'], "#{date}-#{slug}#{DEFAULT_EXT}")

    abort() unless write_file?(filename)

    open(filename, 'w') do |post|
      post.puts post_header.to_yaml
      post.puts '---'
      post.puts 
      post.puts '<!---'
      post.puts 'The filesize block above can be deleted, if your audio files are hosted within the episodes directory.'
      post.puts 'It is only necessary for hosting remotely.'
      post.puts '-->'
      post.puts 
      post.puts "{% podlove_player %}\n\n"
      post.puts "## Shownotes and Links\n\n* Note"
    end

    puts "Created new episode: #{filename}" if File.exist?(filename)

  when 'deploy'
    opts = OptionParser.new do |opts|
      opts._octopod_banner = deploy_help

      opts.on("--document-root [PATH]", "Path to the documwrite_fileent root on the remote machine") do |deploy_document_root|
        options['document_root'] = deploy_document_root
      end

      opts.on("--rsync-delete", "Delete extraneous files from destination dir") do |deploy_rsync_delete|
        options['rsync_delete'] = deploy_rsync_delete
      end

      opts.on("--ssh-host [USER@]<HOST>", "[User and] host of the destination machine") do |deploy_ssh_host|
        options['ssh_host'] = deploy_ssh_host =~ /\A\w*@.*/ ? deploy_ssh_host : "#{ENV['USER']}@#{deploy_ssh_host}"
      end

      opts.on("--ssh-port [PORT]", "SSH port on the remote machine") do |deploy_ssh_port|
        options['ssh_port'] = deploy_ssh_port.to_i
      end
    end
    opts.parse!

    options['public_dir'] = ARGV[1] ? ARGV[1] : File.join(PWD, '_site')
    exclude = ""
    if File.exist?('./rsync-exclude')
      exclude = "--exclude-from '#{File.expand_path('./rsync-exclude')}'"
    end
    puts "## Deploying website via Rsync"

    rsync_command = "rsync --progress -avze 'ssh -p #{options['ssh_port']}' #{exclude} \
      #{"--delete" unless options['rsync_delete'] == false} \
      #{options['public_dir']}/ #{options['ssh_host']}:#{options['document_root']}"

    ok_failed system(rsync_command)

  when 'setup'
    unless File.exist?(PWD + '/_config.dist_backup.yml')
      puts "", "===== Creating a backup of the configuration file ... ====="
      FileUtils.cp(PWD + '/_config.yml', PWD + '/_config.dist_backup.yml', verbose: true)
      puts "===== ... done ===== ", ""
    end


    puts "", "If you are creating a brand new podcasting site, you can safely overwrite and answer with 'Y'."
    puts "If this is an old site, it's better to answer with 'N'." , ""

    puts "", "===== Copying assets ... ====="
    Dir.glob(GEM_DIR + "/assets/**/*").each do |file|
      copy_file_or_create_dir(file)
    end

    Dir.glob(GEM_DIR + "/assets/**/.*").each do |file|
      copy_file_or_create_dir(file)
    end

    if write_file?(PWD + "/_config.yaml")
      FileUtils.cp(GEM_DIR + "/assets/_config.yml.sample", PWD + "/_config.yml", verbose: true)
    end
    puts "===== ... done ===== ", ""

  when 'update'
    # Paths that are always left alone: real posts, hand-written content pages, and the gem's
    # demo episode audio. Unlike 'setup', these are skipped outright rather than offered as a
    # per-file prompt, since this command targets sites that are already live.
    skip_on_update = %w[_posts imprint.md index.md episodes]

    update_file = lambda do |file|
      relative = file.split(GEM_DIR + "/assets")[1]
      next if skip_on_update.any? { |skip| relative == "/#{skip}" || relative.start_with?("/#{skip}/") }
      copy_file_or_create_dir(file)
    end

    puts "", "===== Updating template files to jekyll-octopod #{GEM_SPEC.version} ... ====="
    puts "_posts/, imprint.md, index.md and the demo episodes/ directory are left untouched."
    puts "You'll be asked before any other existing file gets overwritten.", ""

    Dir.glob(GEM_DIR + "/assets/**/*").each(&update_file)
    Dir.glob(GEM_DIR + "/assets/**/.*").each(&update_file)
    puts "===== ... done ===== ", ""

    # As of jekyll-octopod 0.18.0, these paths are served straight from the jekyll-octopod-bulma
    # theme gem instead of being copied here - they're simply no longer under GEM_DIR + "/assets"
    # for the loop above to touch. A leftover copy here would otherwise silently shadow the theme
    # forever (Jekyll always prefers a site's own file over the theme's), with no build error to
    # point at it - so 'update' removes them outright, same "trust git diff, don't special-case"
    # philosophy as the rest of this command. Any '.md' file is kept no matter where it's found,
    # since that's real content, never theme boilerplate.
    now_theme_served = theme_shipped_generic_files + %w[
      podlove-player subscribe-button favicon.ico apple-touch-icon-precomposed.png
      _includes/sidebar.html _includes/post_header.html _includes/post.html _includes/post_line.html
      _includes/disqus_thread.html _includes/disqus_count.html _includes/isso_thread.html
    ]
    found_theme_served = now_theme_served.select { |path| File.exist?(File.join(PWD, path)) }

    unless found_theme_served.empty?
      puts "", "===== Removing files now served by the jekyll-octopod-bulma theme gem ====="
      puts "These used to be copied into your site but are served straight from the"
      puts "jekyll-octopod-bulma theme gem as of jekyll-octopod 0.18.0 - removing the local copies"
      puts "so the theme's current version takes effect ('.md' files, if any, are kept):"
      found_theme_served.each { |path| remove_theme_served_path(File.join(PWD, path)) }
      puts "===== ... done ===== ", ""
    end

    # As of jekyll-octopod 0.19.0, JSON Feed support is gone outright - not moved to the theme
    # gem, just removed (no real podcast client ever consumed it, and a since-fixed bug in this
    # gem's own :after_init hook meant it silently never even built). Any 'feed.*.json' marker
    # file left over from an older site is now genuinely dead: nothing generates its content, and
    # jekyll-octopod-bulma's sidebar no longer links to it. Removed the same way theme-served
    # files are removed above.
    found_json_feeds = Dir.glob(File.join(PWD, 'feed.*.json'))
    unless found_json_feeds.empty?
      puts "", "===== Removing feed.*.json marker files (JSON Feed support was removed) ====="
      found_json_feeds.each { |path| remove_theme_served_path(path) }
      puts "===== ... done ===== ", ""
    end

    puts "", "===== Pointing Gemfile/_config.yml at jekyll-octopod-bulma ... ====="
    update_gemfile_and_theme_config
    puts "===== ... done ===== ", ""

    puts "", "===== Rewriting the old '{% podigee_player %}' tag to '{% podlove_player %}' ... ====="
    podigee_player_tag = /\{%-?\s*podigee_player\b.*?-?%\}/
    updated_posts = Dir.glob(File.join(options['posts_dir'], '**', '*')).select do |post_file|
      next false unless File.file?(post_file)
      content = File.read(post_file)
      next false unless content.match?(podigee_player_tag)
      File.write(post_file, content.gsub(podigee_player_tag, '{% podlove_player %}'))
      true
    end

    if updated_posts.empty?
      puts "No posts used the old 'podigee_player' tag."
    else
      puts "Updated:"
      updated_posts.each { |post_file| puts "  #{post_file}" }
    end
    puts "===== ... done ===== ", ""
  end
else
  puts octopod_help if ARGV.size > 0 && ARGV[0] == '--help'
  load Gem.bin_path('jekyll', 'jekyll')
end
